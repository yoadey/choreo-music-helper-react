{
  "expo": {
    "name": "Choreo Music Helper",
    "slug": "choreo-music-helper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "userInterfaceStyle": "dark",
    "scheme": "choreo-music-helper",
    "splash": {
      "image": "./assets/favicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.yoadey.choreomusic",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon.png",
        "backgroundColor": "#000"
      },
      "package": "de.yoadey.choreomusic"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Choreo Music Helper",
      "shortName": "Choreo Music",
      "themeColor": "#252525",
      "backgroundColor": "#1c1c1e"
    },
    "plugins": [
      "expo-router",
      "react-native-legal"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
