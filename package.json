{
  "name": "choreo-music-helper",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build:web": "expo export -p web && node scripts/postbuild-web.mjs && workbox injectManifest workbox-config.js && metro build temp/sw.js -O dist/sw.js",
    "test:e2e": "playwright test",
    "generate:licenses": "license-kit report --format json --output ./assets/licenses.json"
  },
  "dependencies": {
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.0.2",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.27",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "idb-keyval": "^6.3.0",
    "music-metadata": "^12.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-legal": "^1.8.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-track-player": "^4.1.2",
    "react-native-web": "~0.21.0",
    "rxjs": "^7.8.2",
    "shaka-player": "^4.16.52",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@babel/plugin-transform-private-property-in-object": "^7.29.7",
    "@eslint-react/eslint-plugin": "^5.26.1",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "license-kit": "^0.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "workbox-cli": "^7.4.1"
